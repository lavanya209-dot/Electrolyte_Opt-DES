{\n      \"column\": \"Battery_Score\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.037455223960315615,\n        \"min\": 0.8237768360166402,\n        \"max\": 0.9650303248631268,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          0.9650303248631268,\n          0.83358702182628\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
