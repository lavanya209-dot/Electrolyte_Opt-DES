        "# ==========================================================\n",
        "# DES ELECTROLYTE OPTIMIZATION WORKFLOW (CORRECTED)\n",
        "# ==========================================================\n",
        "\n",
        "!pip install -q xgboost shap tensorflow openpyxl\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    r2_score,\n",
        "    mean_squared_error,\n",
        "    mean_absolute_error\n",
        ")\n",
        "\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "\n",
        "from xgboost import XGBRegressor\n",
        "\n",
        "import shap\n",
        "\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense\n",
        "from tensorflow.keras.layers import Dropout\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# ==========================================================\n",
        "# LOAD DATA\n",
        "# ==========================================================\n",
        "\n",
        "df = pd.read_excel(\"DES_Complete_Properties.xlsx\")\n",
        "\n",
        "print(\"Dataset Shape:\", df.shape)\n",
        "\n",
        "# ==========================================================\n",
        "# KEEP ORIGINAL DES NAME\n",
        "# ==========================================================\n",
        "\n",
        "df[\"DES_Name\"] = df[\"DES System\"]\n",
        "\n",
        "# ==========================================================\n",
        "# CREATE RATIO NUMERIC IF NEEDED\n",
        "# ==========================================================\n",
        "\n",
        "if \"Ratio_numeric\" not in df.columns:\n",
        "\n",
        "    def ratio_to_float(x):\n",
        "\n",
        "        try:\n",
        "            a, b = str(x).replace(\" \", \"\").split(\":\")\n",
        "            return float(a) / float(b)\n",
        "\n",
        "        except:\n",
        "            return np.nan\n",
        "\n",
        "    df[\"Ratio_numeric\"] = df[\"HBA HBD Ratio\"].apply(\n",
        "        ratio_to_float\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# PHYSICS FEATURES\n",
        "# ==========================================================\n",
        "\n",
        "df[\"Fluidity\"] = 1 / (df[\"Viscosity\"] + 1e-8)\n",
        "\n",
        "df[\"Inv_T\"] = 1 / (df[\"T K\"] + 1e-8)\n",
        "\n",
        "df[\"Volume_proxy\"] = 1 / (df[\"Density\"] + 1e-8)\n",
        "\n",
        "df[\"log_Conductivity\"] = np.log10(\n",
        "    df[\"Conductivity\"] + 1\n",
        ")\n",
        "\n",
        "df[\"log_Viscosity\"] = np.log10(\n",
        "    df[\"Viscosity\"] + 1\n",
        ")\n",
        "\n",
        "df[\"Walden\"] = (\n",
        "    df[\"Conductivity\"]\n",
        "    *\n",
        "    df[\"Viscosity\"]\n",
        ")\n",
        "\n",
        "df[\"EPI\"] = (\n",
        "    df[\"Conductivity\"]\n",
        "    /\n",
        "    (df[\"Viscosity\"] + 1e-8)\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# BATTERY SCORE\n",
        "# ==========================================================\n",
        "\n",
        "sigma_norm = (\n",
        "    (df[\"Conductivity\"] - df[\"Conductivity\"].min())\n",
        "    /\n",
        "    (df[\"Conductivity\"].max() - df[\"Conductivity\"].min())\n",
        ")\n",
        "\n",
        "eta_norm = (\n",
        "    (df[\"Viscosity\"] - df[\"Viscosity\"].min())\n",
        "    /\n",
        "    (df[\"Viscosity\"].max() - df[\"Viscosity\"].min())\n",
        ")\n",
        "\n",
        "rho_norm = (\n",
        "    (df[\"Density\"] - df[\"Density\"].min())\n",
        "    /\n",
        "    (df[\"Density\"].max() - df[\"Density\"].min())\n",
        ")\n",
        "\n",
        "df[\"Battery_Score\"] = (\n",
        "    0.5 * sigma_norm\n",
        "    +\n",
        "    0.4 * (1 - eta_norm)\n",
        "    +\n",
        "    0.1 * (1 - rho_norm)\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# ENCODE CATEGORICALS\n",
        "# ==========================================================\n",
        "\n",
        "for col in [\"HBA\", \"HBD\"]:\n",
        "\n",
        "    le = LabelEncoder()\n",
        "\n",
        "    df[col] = le.fit_transform(\n",
        "        df[col].astype(str)\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# FEATURES\n",
        "# ==========================================================\n",
        "\n",
        "features = [\n",
        "\n",
        "    \"HBA\",\n",
        "    \"HBD\",\n",
        "\n",
        "    \"Ratio_numeric\",\n",
        "\n",
        "    \"T K\",\n",
        "\n",
        "    \"x1 DES\",\n",
        "\n",
        "    \"Density\",\n",
        "\n",
        "    \"Viscosity\",\n",
        "\n",
        "    \"Fluidity\",\n",
        "\n",
        "    \"Inv_T\",\n",
        "\n",
        "    \"Volume_proxy\"\n",
        "]\n",
        "\n",
        "target = \"log_Conductivity\"\n",
        "\n",
        "# ==========================================================\n",
        "# FILL MISSING VALUES\n",
        "# ==========================================================\n",
        "\n",
        "for col in features:\n",
        "\n",
        "    if df[col].isna().sum() > 0:\n",
        "\n",
        "        df[col] = df[col].fillna(\n",
        "            df[col].median()\n",
        "        )\n",
        "\n",
        "# ==========================================================\n",
        "# BUILD DATASET\n",
        "# ==========================================================\n",
        "\n",
        "data = df[\n",
        "    features + [target]\n",
        "].copy()\n",
        "\n",
        "print(\"\\nRows available:\", len(data))\n",
        "\n",
        "X = data[features]\n",
        "\n",
        "y = data[target]\n",
        "\n",
        "# ==========================================================\n",
        "# TRAIN TEST SPLIT\n",
        "# ==========================================================\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "\n",
        "    X,\n",
        "    y,\n",
        "\n",
        "    test_size=0.20,\n",
        "\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# RANDOM FOREST\n",
        "# ==========================================================\n",
        "\n",
        "rf = RandomForestRegressor(\n",
        "    n_estimators=500,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "rf.fit(\n",
        "    X_train,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "rf_pred = rf.predict(\n",
        "    X_test\n",
        ")\n",
        "\n",
        "print(\"\\nRANDOM FOREST\")\n",
        "\n",
        "print(\n",
        "    \"R2 =\",\n",
        "    round(\n",
        "        r2_score(\n",
        "            y_test,\n",
        "            rf_pred\n",
        "        ),\n",
        "        4\n",
        "    )\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# XGBOOST\n",
        "# ==========================================================\n",
        "\n",
        "xgb = XGBRegressor(\n",
        "    n_estimators=500,\n",
        "    max_depth=6,\n",
        "    learning_rate=0.05,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "xgb.fit(\n",
        "    X_train,\n",
        "    y_train\n",
        ")\n",
        "\n",
        "xgb_pred = xgb.predict(\n",
        "    X_test\n",
        ")\n",
        "\n",
        "print(\"\\nXGBOOST\")\n",
        "\n",
        "print(\n",
        "    \"R2 =\",\n",
        "    round(\n",
        "        r2_score(\n",
        "            y_test,\n",
        "            xgb_pred\n",
        "        ),\n",
        "        4\n",
        "    )\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# ANN\n",
        "# ==========================================================\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train_scaled = scaler.fit_transform(\n",
        "    X_train\n",
        ")\n",
        "\n",
        "X_test_scaled = scaler.transform(\n",
        "    X_test\n",
        ")\n",
        "\n",
        "model = Sequential()\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        128,\n",
        "        activation=\"relu\",\n",
        "        input_shape=(X_train.shape[1],)\n",
        "    )\n",
        ")\n",
        "\n",
        "model.add(\n",
        "    Dropout(0.2)\n",
        ")\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        64,\n",
        "        activation=\"relu\"\n",
        "    )\n",
        ")\n",
        "\n",
        "model.add(\n",
        "    Dense(\n",
        "        32,\n",
        "        activation=\"relu\"\n",
        "    )\n",
        ")\n",
        "\n",
        "model.add(\n",
        "    Dense(1)\n",
        ")\n",
        "\n",
        "model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"mse\"\n",
        ")\n",
        "\n",
        "early = EarlyStopping(\n",
        "    patience=20,\n",
        "    restore_best_weights=True\n",
        ")\n",
        "\n",
        "model.fit(\n",
        "    X_train_scaled,\n",
        "    y_train,\n",
        "    validation_split=0.2,\n",
        "    epochs=300,\n",
        "    batch_size=32,\n",
        "    verbose=0,\n",
        "    callbacks=[early]\n",
        ")\n",
        "\n",
        "ann_pred = model.predict(\n",
        "    X_test_scaled\n",
        ").flatten()\n",
        "\n",
        "print(\"\\nANN\")\n",
        "\n",
        "print(\n",
        "    \"R2 =\",\n",
        "    round(\n",
        "        r2_score(\n",
        "            y_test,\n",
        "            ann_pred\n",
        "        ),\n",
        "        4\n",
        "    )\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# SHAP\n",
        "# ==========================================================\n",
        "\n",
        "print(\"\\nGenerating SHAP plot...\")\n",
        "\n",
        "explainer = shap.TreeExplainer(xgb)\n",
        "\n",
        "shap_values = explainer.shap_values(\n",
        "    X_test\n",
        ")\n",
        "\n",
        "shap.summary_plot(\n",
        "    shap_values,\n",
        "    X_test\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# TOP ELECTROLYTES\n",
        "# ==========================================================\n",
        "\n",
        "top20 = df.sort_values(\n",
        "    \"Battery_Score\",\n",
        "    ascending=False\n",
        ").head(20)\n",
        "\n",
        "print(\"\\nTOP 20 ELECTROLYTES\")\n",
        "\n",
        "display(\n",
        "    top20[\n",
        "        [\n",
        "            \"DES_Name\",\n",
        "            \"Conductivity\",\n",
        "            \"Viscosity\",\n",
        "            \"Density\",\n",
        "            \"EPI\",\n",
        "            \"Battery_Score\"\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# PARETO SCREENING\n",
        "# ==========================================================\n",
        "\n",
        "pareto = df.copy()\n",
        "\n",
        "pareto[\"Rank\"] = (\n",
        "\n",
        "    pareto[\"Conductivity\"].rank(\n",
        "        ascending=False\n",
        "    )\n",
        "\n",
        "    +\n",
        "\n",
        "    pareto[\"Viscosity\"].rank(\n",
        "        ascending=True\n",
        "    )\n",
        ")\n",
        "\n",
        "pareto_top = pareto.sort_values(\n",
        "    \"Rank\"\n",
        ").head(50)\n",
        "\n",
        "# ==========================================================\n",
        "# SAVE OUTPUTS\n",
        "# ==========================================================\n",
        "\n",
        "top20.to_excel(\n",
        "    \"Top20_Electrolytes.xlsx\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "pareto_top.to_excel(\n",
        "    \"Pareto_Optimal_DES.xlsx\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nFiles saved:\")\n",
        "print(\"Top20_Electrolytes.xlsx\")\n",
        "print(\"Pareto_Optimal_DES.xlsx\")"
      ],
